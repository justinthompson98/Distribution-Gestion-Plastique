# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Email Dispatcher Configurations (For real-time quote form submissions)
# Customize these variables in your "Settings > Secrets" panel to receive email notifications instantly.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_SECURE="false"

# The inbox that will receive completed client submissions (Defaults to info@distributiongp.ca if left empty)
SMTP_RECEIVER_EMAIL="info@distributiongp.ca"

# Formspree endpoint URL (Alternative to SMTP setup)
# For backend-forwarding setup (Full-stack Server):
FORMSPREE_URL=

# For static hosting setups (like Cloudflare Pages direct browser submissions):
VITE_FORMSPREE_URL=

